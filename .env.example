# Copy to .env.local for `npm run dev`, and add the same variables in
# Vercel → Project → Settings → Environment Variables for the live site.

# --- WhatsApp (CallMeBot) ---
# Get the key: save +34 644 91 07 79 in the phone of the receiving number, then WhatsApp it:
#   I allow callmebot to send me messages
CALLMEBOT_APIKEY=
# CALLMEBOT_PHONE=+917990704863          (default)

# --- Email (company Gmail) ---
# Google Account of GMAIL_USER → Security → 2-Step Verification ON → "App passwords" → create one.
GMAIL_APP_PASSWORD=
# GMAIL_USER=buildsafeenterprise@gmail.com                              (default)
# LEAD_EMAIL_TO=buildsafeenterprise@gmail.com,admin.buildsafe@gmail.com (default)
